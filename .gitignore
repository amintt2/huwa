# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# expo-updates code signing: the public certificate ships in the app and IS committed;
# private keys never are (services/ota/keys/, credentials.json, keystores).
!certs/certificate.pem
services/ota/keys/
services/**/secrets/*
services/**/data/
services/**/.env
credentials.json
*.keystore

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

!services/**/secrets/.gitkeep

# Claude agent worktrees
.claude/worktrees/
modules/huwa-torrent/ios/HuwaTorrentCore.xcframework/

# Bare worklet bundle (npm run build:worklet, runs on postinstall)
src/p2p/worklet.bundle.js

# asc build artifacts
.asc/

# App Store posters and raw captures (regenerated with scripts/shots.ts)
store/shots/
store/screens/

# Paperback extension sandbox bundle (npm run build:paperback, runs on postinstall)
src/manga-ext/runtime/runtime.bundle.js
