{
  "name": "huwa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Huwa P2P gateway for browsers: non-custodial dht-relay (vendored fork in ./dht-relay) over WebSocket, persistent HyperDHT node, rendezvous mailbox (docs/server-api.md \u00a714).",
  "main": "index.js",
  "bin": {
    "huwa-gateway": "index.js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-timeout=240000 test/*.test.js dht-relay/test/*.test.js"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "6.9.2",
    "b4a": "1.9.0",
    "compact-encoding": "3.5.2",
    "compact-encoding-net": "1.3.0",
    "events": "3.3.0",
    "hyperdht": "6.34.0",
    "noise-curve-ed": "2.1.0",
    "noise-handshake": "4.2.0",
    "protomux": "3.12.1",
    "safety-catch": "1.0.3",
    "sodium-universal": "5.0.1",
    "streamx": "2.28.1",
    "timeout-refresh": "2.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "hyperswarm": "4.17.2"
  }
}
