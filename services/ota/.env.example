# Copier en `.env` (git-ignoré). Ne jamais commiter les valeurs réelles.

# URL publique du serveur (derrière le reverse proxy TLS). Doit correspondre à
# `expo.updates.url` dans app.json, sans le suffixe `/manifest`.
BASE_URL=https://ota.example.org

# Secret des sessions du tableau de bord et des jetons d'upload : `openssl rand -hex 32`
JWT_SECRET=

# Clé maîtresse (32 octets base64) qui scelle les clés de signature dans Postgres :
# `openssl rand -base64 32`. La perdre = impossible de re-signer, il faudra recréer l'app
# et republier un binaire avec un nouveau certificat.
DB_KEYS_MASTER_KEY_B64=

# Mot de passe Postgres (utilisé par les deux conteneurs)
POSTGRES_PASSWORD=

# Compte administrateur initial (lu une seule fois au premier démarrage).
# Mot de passe : 8 caractères min., majuscule, minuscule, chiffre, caractère spécial.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Optionnel : couper la télémétrie du serveur
DISABLE_TELEMETRY=true
