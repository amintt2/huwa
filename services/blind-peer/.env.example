# Port UDP fixe du blind peer (à ouvrir dans le pare-feu)
PORT=49738
# Quota disque en Mo (le blind peer fait son propre GC au-delà)
MAX_STORAGE_MB=20000
# Optionnel : clé publique (hex ou z32) de la passerelle push (services/push-gateway), affichée dans ses logs
PUSH_GATEWAY_KEY=
# Optionnel : clé publique d'un pair de confiance autorisé à annoncer des cores (announce:true)
TRUSTED_PEER=
