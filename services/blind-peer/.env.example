# Port UDP du nœud DHT (publié à l'identique et à ouvrir dans le pare-feu : ufw allow 49738/udp)
PORT=49738
# Budget disque total en Mo (au-delà, le GC de blind-peer vide d'abord les cores les moins prioritaires et les moins actifs)
MAX_STORAGE_MB=20000
# Quota par compte / par base en Mo (policy.js)
GROUP_QUOTA_MB=50
# Un core ni demandé ni répliqué depuis ce nombre de jours est supprimé
MAX_IDLE_DAYS=120
# Intervalle des passes de la politique (minutes)
SWEEP_MINUTES=60
# Limite native de blind-peer : requêtes add-cores par base (capacité / recharge en ms)
REFERRER_RATE_CAPACITY=60
REFERRER_RATE_INTERVAL_MS=1000
# Optionnel : clés publiques (z32/hex, séparées par des virgules) de pairs de confiance (announce:true, suppression)
TRUSTED_PEERS=
# Optionnel : clés publiques de passerelles push (services/push-gateway)
PUSH_GATEWAY_KEYS=
