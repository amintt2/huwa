# syntax=docker/dockerfile:1.7
#
# Huwa site image (ghcr.io/amintt2/huwa:<version>-web), what huwa.mciut.fr runs (D15): the site
# that asks to install the app (site/: home page, /get, /privacy, /terms, /pack, /extensions,
# AltStore sources, .well-known association files), served by huwa-server with /huwa-config.json
# and the P2P gateway. Built WITHOUT the torrent engine, the HTTP / fetch proxy and ffmpeg
# (`--no-default-features`: /api/v1/engine is a 404), and without the web app: huwa.mciut.fr
# neither streams nor offers a streaming server. The web app stays in the full image
# (docker/Dockerfile) for self-hosting. It replaces the nginx-only site/Dockerfile.
#
#   docker build -f docker/Dockerfile.web -t huwa:web .
#   docker run --rm -p 8080:8080 -e HUWA_RELAY=0 -e HUWA_INDEXABLE=1 huwa:web
#
# Coolify (huwa.mciut.fr): deploy/coolify/huwa-site.yaml.

ARG NODE_VERSION=22
ARG RUST_IMAGE=rust:1-bookworm

# ---- 1. Site of huwa.mciut.fr (what site/Dockerfile + nginx served) ------------------------------
# index.html is the install page, also answered at /get (old links). site/sw.js replaces the web
# app's service worker in browsers that had installed it. huwa-server applies site/nginx.conf's
# rules (src/web.rs): JSON association files, /addon & /install → extensions.html, /privacy →
# privacy.html… Unknown paths (old web app routes) fall back to the install page.
FROM debian:bookworm-slim AS webroot
COPY site/ /out/
RUN cd /out \
 && cp index.html get.html \
 && rm -f Dockerfile Dockerfile.dockerignore nginx.conf
RUN test -f /out/index.html -a -f /out/get.html -a -f /out/sw.js -a -f /out/.well-known/apple-app-site-association \
 && grep -q '"applinks"' /out/.well-known/apple-app-site-association \
 && ! grep -q 'id="root"' /out/index.html

# ---- 2. huwa-server without the engine --------------------------------------------------------
FROM ${RUST_IMAGE} AS rust
WORKDIR /src/native
COPY native/huwa-server/Cargo.toml native/huwa-server/Cargo.lock ./huwa-server/
# The manifest names the engine (optional, off here) and the vendored patches: cargo reads them.
COPY native/vendor ./vendor
COPY native/huwa-torrent-core ./huwa-torrent-core
RUN mkdir -p huwa-server/src && echo "" > huwa-server/src/lib.rs && echo "fn main() {}" > huwa-server/src/main.rs \
 && cd huwa-server && cargo build --locked --release --no-default-features || true
COPY native/huwa-server ./huwa-server
RUN cd huwa-server \
 && touch src/lib.rs src/main.rs \
 && cargo build --locked --release --no-default-features \
 && cp target/release/huwa-server /usr/local/bin/huwa-server \
 && /usr/local/bin/huwa-server --version

# ---- 3. Node children --------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm AS gateway
WORKDIR /opt/huwa
COPY services/huwa-gateway/package.json services/huwa-gateway/package-lock.json ./gateway/
RUN --mount=type=cache,target=/root/.npm cd gateway && npm ci --omit=dev --no-audit --no-fund
COPY services/huwa-gateway/ ./gateway/
COPY services/blind-peer/package.json services/blind-peer/package-lock.json ./blind-peer/
RUN --mount=type=cache,target=/root/.npm cd blind-peer && npm ci --omit=dev --no-audit --no-fund
COPY services/blind-peer/server.js services/blind-peer/policy.js ./blind-peer/
# Holepunch packages ship native prebuilds for every OS / arch (~ 70 % of node_modules): keep
# this platform's (glibc) only.
RUN plat="$(node -p 'process.platform + "-" + process.arch')" \
 && find /opt/huwa -type d -name prebuilds -prune | while read -r d; do \
      for p in "$d"/*; do case "$(basename "$p")" in "$plat"|"$plat"-*) ;; *) rm -rf "$p" ;; esac; done; \
    done \
 && find /opt/huwa -type f \( -name '*.md' -o -name '*.map' \) -path '*/node_modules/*' -delete \
 && du -sh /opt/huwa/gateway /opt/huwa/blind-peer

FROM node:${NODE_VERSION}-bookworm-slim AS node

# ---- 4. Runtime (no ffmpeg) ----------------------------------------------------------------------
FROM debian:bookworm-slim AS web-runtime
ARG VERSION=dev
LABEL org.opencontainers.image.title="Huwa Site" \
      org.opencontainers.image.description="Huwa install site + P2P gateway (no web app, no torrent engine, no ffmpeg, no fetch proxy)" \
      org.opencontainers.image.source="https://github.com/amintt2/huwa" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0"
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends ca-certificates tini libatomic1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN groupadd --system --gid 1000 huwa \
 && useradd --system --uid 1000 --gid huwa --home-dir /home/huwa --create-home --shell /usr/sbin/nologin huwa \
 && mkdir -p /data /cache /opt/huwa \
 && chown huwa:huwa /data /cache
COPY --from=rust /usr/local/bin/huwa-server /usr/local/bin/huwa-server
COPY --from=gateway /opt/huwa/gateway /opt/huwa/gateway
COPY --from=gateway /opt/huwa/blind-peer /opt/huwa/blind-peer
COPY --from=webroot /out/ /opt/huwa/web/
COPY LICENSE /usr/share/doc/huwa/LICENSE
ENV HUWA_PORT=8080 \
    HUWA_DATA_DIR=/data \
    HUWA_CACHE_DIR=/cache \
    HUWA_WEB_DIR=/opt/huwa/web \
    HUWA_TORRENT=0 \
    HUWA_TRANSCODE=0 \
    NODE_ENV=production
USER huwa
WORKDIR /home/huwa
VOLUME ["/data", "/cache"]
EXPOSE 8080 49737/udp
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["/usr/local/bin/huwa-server", "--healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/huwa-server"]
